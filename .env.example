# Required
DISCORD_TOKEN=
DISCORD_GUILD_ID=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6.2-astra

# Optional: comma-separated channel IDs to read. Empty = every channel the bot can see.
DISCORD_CHANNEL_IDS=

# Google Drive (skipped if unset). OAuth is preferred: client JSON from Google Cloud plus a local refresh-token path.
GOOGLE_OAUTH_CLIENT_FILE=
GOOGLE_OAUTH_TOKEN_FILE=drive-token.json
# Legacy service-account JSON fallback. The account must be shared on the folder; leave empty when using OAuth.
GOOGLE_SERVICE_ACCOUNT_FILE=
# Optional: direct children of this folder only. Set it for the pilot rather than ingesting every accessible file.
GOOGLE_DRIVE_FOLDER_ID=

# Zoom (skipped if unset): Server-to-Server OAuth app with the meeting summary read scopes
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=

# Invoice inbox over IMAP (skipped if unset). Gmail: imap.gmail.com + an app password
EMAIL_HOST=
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FOLDER=INBOX
EMAIL_SEARCH=OR SUBJECT invoice SUBJECT receipt

# Tuning
POLL_MINUTES=15
BACKFILL_DAYS=14
DB_PATH=brain.db

# Company Brain mirror (optional). Leave all three empty to keep using SQLite only.
COMPANY_BRAIN_URL=
COMPANY_BRAIN_API_KEY=
COMPANY_BRAIN_SCOPE=org:utmist-startups
