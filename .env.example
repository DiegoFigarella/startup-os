# Required
DISCORD_TOKEN=
DISCORD_GUILD_ID=
ANTHROPIC_API_KEY=

# Optional: comma-separated channel IDs to read. Empty = every channel the bot can see.
DISCORD_CHANNEL_IDS=

# Google Drive (skipped if unset): service account JSON, with the shared drive shared to its email
GOOGLE_SERVICE_ACCOUNT_FILE=

# Zoom (skipped if unset): Server-to-Server OAuth app with the meeting summary read scopes
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=

# Invoice inbox over IMAP (skipped if unset). Gmail: imap.gmail.com + an app password
EMAIL_HOST=
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FOLDER=INBOX
EMAIL_SEARCH=OR SUBJECT invoice SUBJECT receipt

# Tuning
POLL_MINUTES=15
BACKFILL_DAYS=14
DB_PATH=brain.db
